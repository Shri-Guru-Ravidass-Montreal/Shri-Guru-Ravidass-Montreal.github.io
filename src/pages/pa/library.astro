---
import LibraryPage from "@/components/pages/LibraryPage.astro";
import { siteContent } from "@/data/site";
import Layout from "@/layouts/Layout.astro";
const locale = "pa" as const;
---

<Layout
    title={siteContent[locale].libraryPage.title}
    description={siteContent[locale].libraryPage.intro}
    locale={locale}
    page="library"
>
    <LibraryPage locale={locale} />
</Layout>
