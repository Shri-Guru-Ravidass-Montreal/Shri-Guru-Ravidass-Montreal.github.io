---
import { Image } from 'astro:assets';
import type { ServiceData } from '../../data/site';
interface Props { service: ServiceData; href: string; }
const { service, href } = Astro.props;
---
<a href={href} class="service-card">
  <Image src={service.image} alt={service.alt} width={700} height={700} format="webp" class="service-card-image" />
  <span class="service-card-shade"></span>
  <span class="service-card-content"><strong>{service.title}</strong><span>{service.description}</span></span>
</a>
