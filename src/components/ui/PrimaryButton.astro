---
interface Props {
    href?: string;
    type?: "button" | "submit";
}
const { href, type = "button" } = Astro.props;
---

{ href ? (
    <a href={href} class="button button-primary">
        <slot />
    </a>
) : (
    <button type={type} class="button button-primary">
        <slot />
    </button>
) }
