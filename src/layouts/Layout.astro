---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import gurdwara from '../assets/outside.png';
import type { ImageMetadata } from 'astro';
import type { Locale, PageKey } from '../data/site';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	locale: Locale;
	page: PageKey;
	backgroundImage?: ImageMetadata;
	backgroundFallbackImage?: ImageMetadata;
}

const {
	title,
	description = 'Shri Guru Ravidass Temple in Montreal.',
	image = '/favicon.svg',
	locale,
	page,
	backgroundImage = gurdwara,
	backgroundFallbackImage,
} = Astro.props;

// Keep search visibility disabled until the site is ready for SEO.
const indexingEnabled = false;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="robots" content={indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="og:image" content={image} />
		<title>{title}</title>
	</head>
	<body class="site-body min-h-screen overflow-x-clip text-stone-950">
		<div class="site-shell relative isolate flex min-h-screen flex-col overflow-x-clip">
			<Header locale={locale} page={page} />
			<div class="site-content-shell relative isolate flex flex-1 flex-col">
				<div class="site-background" aria-hidden="true">
					<div class="site-background-frame">
						<Image src={backgroundImage} alt="" width={1600} height={1100} class="h-full w-full object-cover object-center" />
						{backgroundFallbackImage && <Image src={backgroundFallbackImage} alt="" width={1600} height={1100} class="site-background-fallback h-full w-full object-cover object-center" />}
					</div>
				</div>

			<main class="relative flex-1 pb-16 pt-16 sm:pb-24 sm:pt-24">
				<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-px bottom-0 z-0 px-0 min-[431px]:px-4 lg:px-8">
					<div class="relative mx-auto h-full max-w-6xl">
						<div
							class="absolute inset-y-0 left-0 w-8 rounded-r-[1.6rem] border-r border-amber-50/40 bg-linear-to-b from-amber-200/95 via-amber-100/85 to-amber-300/30 shadow-[inset_-18px_0_28px_rgba(100,70,20,0.28)] min-[431px]:w-20"
						></div>
						<div
							class="absolute inset-y-0 right-0 w-8 rounded-l-[1.6rem] border-l border-amber-50/40 bg-linear-to-b from-amber-200/95 via-amber-100/85 to-amber-300/30 shadow-[inset_18px_0_28px_rgba(100,70,20,0.28)] min-[431px]:w-20"
						></div>
						<div
							class="absolute inset-x-10 top-6 h-32 rounded-full bg-amber-300/35 blur-3xl min-[431px]:inset-x-20"
						></div>
					</div>
				</div>

				<div class="relative z-10">
					<slot />
				</div>
			</main>
			<Footer locale={locale} />
			</div>
		</div>
	</body>
</html>
